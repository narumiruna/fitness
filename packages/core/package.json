{
  "name": "@narumitw/fitness-core",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-safe calendar, training, and statistics rules for Fitness.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./training": {
      "types": "./dist/training.d.ts",
      "import": "./dist/training.js"
    },
    "./stats-calculations": {
      "types": "./dist/stats-calculations.d.ts",
      "import": "./dist/stats-calculations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  }
}
