{
  "name": "@narumitw/fitness-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx watch --include '../../packages/core/dist/**/*.js' --include '../../packages/contracts/dist/**/*.js' src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@narumitw/fitness-contracts": "1.0.0",
    "@narumitw/fitness-core": "1.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "hono": "^4.12.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  }
}
