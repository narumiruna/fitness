generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  passwordHash String
  role         String             @default("USER")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  exercises    Exercise[]
  sessions     Session[]
  templates    WorkoutTemplate[]
  workouts     Workout[]
  measurements BodyMeasurement[]
  goal         BodyGoal?
  schedules    TemplateSchedule[]
  imports      ImportBatch[]
  passkeys     Passkey[]
}

model Passkey {
  id           String   @id
  userId       String
  name         String
  publicKey    Bytes
  counter      BigInt
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasskeyChallenge {
  tokenHash String   @id
  challenge String
  purpose   String
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Exercise {
  id              String               @id @default(cuid())
  slug            String               @unique
  defaultName     String
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  aliases         ExerciseAlias[]
  createdBy       User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  names           ExerciseName[]
  sets            WorkoutSet[]
  templateSets    WorkoutTemplateSet[]
  muscles         ExerciseMuscle[]
  equipment       ExerciseEquipment[]
  rules           ProgressionRule[]

  @@index([defaultName])
}

model ExerciseName {
  id         String   @id @default(cuid())
  exerciseId String
  locale     String
  name       String
  isPrimary  Boolean  @default(false)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale, name])
  @@index([locale, name])
}

model ExerciseAlias {
  id              String   @id @default(cuid())
  exerciseId      String
  locale          String
  alias           String
  normalizedAlias String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([locale, normalizedAlias])
  @@index([exerciseId])
}

model Workout {
  id            String           @id @default(cuid())
  userId        String
  date          DateTime
  title         String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  state         String           @default("COMPLETED")
  version       Int              @default(0)
  startedAt     DateTime?
  resumedAt     DateTime?
  finishedAt    DateTime?
  activeSeconds Int              @default(0)
  restSeconds   Int              @default(90)
  restDeadline  DateTime?
  startKey      String?          @unique
  templateId    String?
  templateTitle String?
  plannedDate   DateTime?
  importBatchId String?
  fingerprint   String?
  template      WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sets          WorkoutSet[]
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plannedDate])
  @@unique([userId, fingerprint])
  @@index([userId, date])
}

model WorkoutSet {
  id           String   @id @default(cuid())
  workoutId    String
  exerciseId   String
  order        Int
  weight       Float
  reps         Int
  notes        String?
  type         String   @default("WORKING")
  rir          Float?
  completed    Boolean  @default(true)
  targetWeight Float?
  targetReps   Int?
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([workoutId, order])
}

model WorkoutTemplate {
  id        String               @id @default(cuid())
  userId    String
  title     String
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  sets      WorkoutTemplateSet[]
  workouts  Workout[]
  rules     ProgressionRule[]
  schedules TemplateSchedule[]
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WorkoutTemplateSet {
  id         String          @id @default(cuid())
  templateId String
  exerciseId String
  order      Int
  weight     Float
  reps       Int
  notes      String?
  type       String          @default("WORKING")
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([templateId, order])
}

model ExerciseMuscle {
  exerciseId String
  muscle     String
  role       String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscle])
}

model ExerciseEquipment {
  exerciseId String
  equipment  String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipment])
}

model ProgressionRule {
  templateId String
  exerciseId String
  increment  Float
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([templateId, exerciseId])
}

model TemplateSchedule {
  id            String           @id @default(cuid())
  userId        String
  templateId    String?
  title         String
  weekday       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, weekday, effectiveFrom])
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weight    Float?
  waist     Float?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyGoal {
  userId String @id
  weight Float?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportBatch {
  id        String    @id @default(cuid())
  userId    String
  digest    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts  Workout[]

  @@unique([userId, digest])
}
