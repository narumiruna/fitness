{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./apps/web/src/*"] }
  },
  "include": [
    "scripts/**/*.ts",
    "prisma/seed.ts",
    "tests/**/*.ts",
    "prisma*.config.ts"
  ],
  "exclude": ["node_modules", "apps/**/dist", "packages/**/dist"]
}
