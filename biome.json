{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.agents", "!dist", "!node_modules", "!data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessTypeConstraint": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "useAsConstAssertion": "error",
        "useConsistentArrayType": "error",
        "useConst": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noExtraNonNullAssertion": "error"
      }
    }
  }
}
