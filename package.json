{
  "name": "fitness",
  "version": "1.0.0",
  "description": "A multi-user strength training tracker.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8783",
    "build": "next build",
    "start": "next start -p 8783",
    "biome:ci": "biome ci .",
    "biome:check": "biome check .",
    "biome:format": "biome format .",
    "lint": "npm run biome:ci",
    "format": "npm run biome:format -- --write",
    "typecheck": "tsc --noEmit",
    "check": "npm run biome:ci && npm run typecheck",
    "test:ui": "node tests/run-ui.mjs",
    "test:ui:production": "npm run build && node tests/run-ui.mjs --production",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "workouts:export-csv": "tsx scripts/export-workouts-csv.ts",
    "workouts:import-csv": "tsx scripts/import-workouts-csv.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/fitness.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bugs": {
    "url": "https://github.com/narumiruna/fitness/issues"
  },
  "homepage": "https://github.com/narumiruna/fitness#readme",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
