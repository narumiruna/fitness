{
  "name": "fitness",
  "version": "1.0.0",
  "description": "A multi-user strength training tracker.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "npm run build --workspace @narumitw/fitness-core && npm run build --workspace @narumitw/fitness-contracts",
    "test:core": "npm run build --workspace @narumitw/fitness-core && npm test --workspace @narumitw/fitness-core",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "check:changesets": "node scripts/check-changesets.mjs",
    "test:changesets": "node --test tests/changesets.test.mjs",
    "predev": "npm run db:generate && prisma db push --config prisma-dev.config.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:packages && npm run build --workspace @narumitw/fitness-api && npm run build --workspace @narumitw/fitness-web",
    "start": "NODE_ENV=production sh -c 'prisma migrate deploy && exec node apps/api/dist/server.js'",
    "biome:ci": "biome ci .",
    "biome:check": "biome check .",
    "biome:format": "biome format .",
    "lint": "npm run biome:ci",
    "format": "npm run biome:format -- --write",
    "typecheck": "npm run build:packages && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "check": "npm run biome:ci && npm run typecheck",
    "test:i18n": "node --import tsx --test tests/i18n.test.ts",
    "test:db-init": "node --test --test-concurrency=1 tests/dev-database.test.mjs tests/postgres-cleanup.test.mjs tests/production-ui-server.test.mjs tests/dev-orchestrator.test.mjs tests/tls-proxy.test.mjs",
    "test:dashboard": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test tests/dashboard.test.ts",
    "test:training": "node --import tsx --test tests/training.test.ts",
    "test:training:sqlite": "node tests/run-training.mjs",
    "test:training:postgres": "node tests/run-training.mjs --postgres",
    "test:logging": "node --import tsx --test tests/logging.test.ts",
    "test:logging:docker": "node --test tests/docker-logging.test.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:ui:production": "npm run build && node tests/run-ui.mjs --production",
    "postinstall": "npm run db:generate",
    "prepare": "husky",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "npm run db:generate && prisma db push --config prisma-dev.config.ts",
    "db:seed": "NODE_ENV=development tsx prisma/seed.ts",
    "workouts:export-csv": "tsx scripts/export-workouts-csv.ts",
    "workouts:import-csv": "tsx scripts/import-workouts-csv.ts",
    "test:api": "node tests/run-api.mjs",
    "test:api:postgres": "node tests/run-api.mjs --postgres",
    "test:mcp:clients": "npm run build:packages && node tests/mcp-clients.mjs",
    "test:mcp:cimd": "node tests/mcp-clients.mjs --cimd",
    "test:mcp:native-cimd": "node tests/mcp-clients.mjs --native-cimd",
    "test:contracts": "npm run build:packages && npm test --workspace @narumitw/fitness-contracts",
    "test": "npm run test:core && npm run test:contracts && npm run test:changesets && npm run test:i18n && npm run test:dashboard && npm run test:training && npm run test:logging && node --import tsx --test tests/form-outcome.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/fitness.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bugs": {
    "url": "https://github.com/narumiruna/fitness/issues"
  },
  "homepage": "https://github.com/narumiruna/fitness#readme",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@narumitw/fitness-core": "1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@openai/codex": "0.163.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
